# Variables de entorno de Vértice. Copiar a /etc/vertice/vertice.env (lo hace instalar.sh), permisos 600, y completar.
# NUNCA subir este archivo con valores reales a GitHub ni pegarlo en un chat.

VERTICE_ENTORNO=produccion          # en producción el servidor NO arranca si faltan los secretos de WhatsApp
VERTICE_DB=/var/lib/vertice/vertice.db
VERTICE_NEGOCIOS=/etc/vertice/negocios      # un archivo .yaml por clínica (copiar y editar clinica-demo.yaml)
VERTICE_RESPALDOS=/var/lib/vertice/respaldos

# --- Motor de IA (poner la llave del proveedor elegido; crearla a nombre del NEGOCIO y con un tope de gasto mensual) ---
VERTICE_PROVEEDOR=openai            # openai | claude
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Las notas de voz se transcriben con OpenAI aunque el motor sea Claude: OPENAI_API_KEY es necesaria en ambos casos.

# --- WhatsApp (Meta). El TOKEN debe ser el permanente de un "usuario del sistema", no el temporal de 24 h ---
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=              # una frase larga inventada por ti; la misma que escribes en Meta al registrar el webhook

# --- Claves del panel (soporte). Una por clínica: VERTICE_PANEL_CLAVE_<ID_EN_MAYÚSCULAS_CON_GUION_BAJO> ---
VERTICE_PANEL_CLAVE_CLINICA_DEMO=

# --- Monitoreo y respaldos ---
VERTICE_MONITOR_TOKEN=              # protege /salud/detalle
VERTICE_ALERTA_URL=                 # ej. https://ntfy.sh/<tema-largo-y-secreto>  (instala la app ntfy en tu celular y suscríbete a ese tema)
VERTICE_URL_PUBLICA=                # ej. https://TU-DOMINIO  (para comprobar que el servidor responde desde afuera)
VERTICE_RESPALDO_CLAVE=             # cifra los respaldos. GUÁRDALA en un gestor de contraseñas: sin ella no se pueden restaurar
VERTICE_RESPALDO_SUBIR=             # comando que copia el respaldo a OTRO lugar, ej. rclone copy {archivo} remoto:vertice

LOG_LEVEL=INFO
